# PostgreSQL connection string
# For local dev without Docker: run `docker compose up postgres` then use the URL below
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/flora_pdv"

# Individual Postgres credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flora_pdv

# Google Gemini API key (optional)
GEMINI_API_KEY=

# App URL (for AI Studio compatibility)
APP_URL=
